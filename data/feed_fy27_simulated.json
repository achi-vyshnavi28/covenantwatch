    {
      "id": "EV01",
      "doc": "madhur_steel",
      "date": "2026-08-02",
      "text": "The vehicle loan EMI for July was paid on the due date.",
      "consent_obtained": null
    },
    {
      "id": "EV02",
      "doc": "madhur_steel",
      "date": "2026-10-14",
      "text": "The company availed a Rs 12 crore supply-chain finance line from HDFC Bank to fund higher steel inventory.",
      "consent_obtained": false
    },
    {
      "id": "EV03",
      "doc": "madhur_steel",
      "date": "2026-11-05",
      "text": "Tata Capital enhanced the channel finance limit by Rs 3 crore; NOC was obtained from PNB, RBL Bank and Bajaj Finance beforehand.",
      "consent_obtained": true
    },
    {
      "id": "EV04",
      "doc": "madhur_steel",
      "date": "2027-01-20",
      "text": "ICRA revised the long-term rating of the company to [ICRA]BBB- (Negative) from [ICRA]BBB (Stable).",
      "consent_obtained": null
    },
    {
      "id": "EV05",
      "doc": "atomberg",
      "date": "2026-09-15",
      "text": "The company launched a new range of smart ceiling fans with voice control.",
      "consent_obtained": null
    },
    {
      "id": "EV06",
      "doc": "atomberg",
      "date": "2026-12-10",
      "text": "The company invested Rs 50 million as equity in its Bangladesh subsidiary to fund local distribution.",
      "consent_obtained": false
    },
    {
      "id": "EV07",
      "doc": "anchor_offshore",
      "date": "2026-10-20",
      "text": "Members approved alteration of the Articles of Association; prior written consent of the lenders was obtained.",
      "consent_obtained": true
    },
    {
      "id": "EV08",
      "doc": "anchor_offshore",
      "date": "2026-12-01",
      "text": "The company opened a new service base at Kakinada port.",
      "consent_obtained": null
    },
    {
      "id": "EV09",
      "doc": "anchor_offshore",
      "date": "2027-01-05",
      "text": "The Chief Financial Officer has resigned with effect from 31 January.",
      "consent_obtained": false
    }
  ]
